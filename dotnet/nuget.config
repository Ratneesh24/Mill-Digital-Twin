<?xml version="1.0" encoding="utf-8"?>
<!--
  OFFLINE BUILD CONFIG for the CRM04 digital twin.

  This file is COMMITTED and already sits where it belongs, next to Crm04.sln. There is
  nothing to copy: the 160 .nupkg files it points at are committed too, in
  dotnet/offline-packages/, so a clone or a GitHub ZIP download restores with no internet
  and no setup at all.

  <clear /> removes nuget.org, so no build here will ever reach the internet again. If a
  package is genuinely missing you get NU1101 ("unable to find package X") naming it,
  instead of the NU1301 connection timeout - that is the point of clearing.

  THE COROLLARY, and it bites: adding a new PackageReference fails with NU1101 for
  everyone, online or not, until offline-packages/ is refreshed in the SAME commit that
  changes Directory.Packages.props. See offline-packages/READ-ME-FIRST.txt.

  The "value" below is relative to THIS FILE's folder, so it works on any drive letter.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="crm04-offline" value="offline-packages" />
  </packageSources>

  <!-- Belt and braces: even if a machine-wide config re-adds nuget.org, it stays off. -->
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>

  <config>
    <!-- Keep the extracted cache local and short. Long paths + the OPC UA package names
         exceed the Windows 260-character limit under deep folders. -->
    <add key="globalPackagesFolder" value="packages-cache" />
  </config>

</configuration>
