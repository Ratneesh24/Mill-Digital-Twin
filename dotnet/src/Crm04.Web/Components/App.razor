<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#005a9c" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <title>CRM04 · 4HI Reversing Mill · Digital Twin</title>

    @*
        three.js is VENDORED, not fetched from a CDN - this has to run on an isolated plant
        network. The import map resolves the bare "three" specifier that OrbitControls uses;
        without it that import fails and the 3D page is a blank canvas with a console error.
    *@
    <script type="importmap">
    {
      "imports": {
        "three": "/js/vendor/three.module.min.js"
      }
    }
    </script>

    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="js/site.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
