@*
    A KPI that is NOT a tag - motor load, specific energy, pass counters.

    Rendered in the same tile shape so the ribbon stays even, but the caller supplies the content
    because there is no tag to read and therefore no provenance to badge. Port of KpiSlot in
    src/components/dashboard/KpiTile.tsx.
*@

<div class="kpi-tile border-line bg-base-900 border" style="@(Accent is null ? null : $"--kpi-accent:{Accent}")">
    <div class="label truncate">@Label</div>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = default!;

    [Parameter] public string? Accent { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }
}
