@*
    SIMULATION CONTROLS — feed-status variant.

    The React app's SimulationControls sends START/STOP/TRIM/SCENARIO commands
    into its in-browser SimulationEngine. The Blazor port has no in-browser
    solver: the feed is the API's replay (or Oracle), so there is nothing to
    command and a working START button would be a lie.

    Visual parity is kept — same panel, same command grid, same trim rows and
    scenario list — but everything is disabled with the reason stated, exactly
    as the React panel disables itself in LIVE mode. The live part of this
    panel is the FEED: source, rate, age, staleness.
*@
@using Crm04.Domain.Types
@using Crm04.Domain.Util
@using Crm04.Web.Components.Common
@using Crm04.Web.State
@inject MillStore Mill
@inject UiTickService Ticker
@implements IDisposable

<Panel Title="Simulation controls">
    <Right>
        <span class="text-micro tracking-wider text-prov-simulated">SIMULATED STATE ONLY</span>
    </Right>
    <ChildContent>
        <div class="grid grid-cols-4 gap-1.5">
            <span class="border-line text-text-faint bg-base-900 inline-flex items-center justify-center gap-1 rounded-[10px] border px-1 py-2 text-micro tracking-wider">▷ START</span>
            <span class="border-line text-text-faint inline-flex items-center justify-center gap-1 rounded-[10px] border px-1 py-2 text-micro tracking-wider">☐ STOP</span>
            <span class="border-trip/60 text-trip inline-flex items-center justify-center gap-1 rounded-[10px] border px-1 py-2 text-micro tracking-wider">FAST STOP</span>
            <span class="border-line text-text-faint inline-flex items-center justify-center gap-1 rounded-[10px] border px-1 py-2 text-micro tracking-wider">⟳ RESET</span>
        </div>
        <p class="text-text-faint text-micro mt-1.5 leading-snug">
            Replay feed — commands are disabled. Mill motion follows the API
            (@(Mill.Summary?.Communication.SourceName ?? "replay")).
            @(Mode == OperatingMode.Live ? "LIVE IS READ-ONLY." : "")
        </p>

        <div class="border-line mt-2 border-t pt-2">
            @foreach (var trim in Trims)
            {
                <div class="flex flex-wrap items-center justify-between gap-x-2 gap-y-1 py-[3px]" @key="trim.Label">
                    <span class="label min-w-[130px] flex-1">@trim.Label <span class="text-text-faint">(@trim.Unit)</span></span>
                    <div class="flex shrink-0 gap-1">
                        @foreach (var step in trim.Steps)
                        {
                            <span @key="step" class="border-line text-text-faint num w-11 rounded-md border py-1 text-center text-micro">@step</span>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="border-line mt-2 flex flex-wrap items-center gap-2 border-t pt-2">
            <span class="rounded-[10px] border px-2.5 py-1.5 text-micro tracking-wider border-line text-text-faint">AGC OFF</span>
            <span class="rounded-[10px] border px-2.5 py-1.5 text-micro tracking-wider border-line text-text-faint">CHARGE NEXT COIL</span>
            <span class="text-text-faint num ml-auto text-micro">@StatusLabel</span>
        </div>

        <div class="border-line mt-2 border-t pt-2">
            <div class="label mb-1">SCENARIO</div>
            <div class="grid grid-cols-2 gap-1">
                @foreach (var s in Scenarios)
                {
                    <span @key="s" class="rounded-[10px] border px-2 py-1.5 text-left text-micro leading-tight border-line text-text-faint">@s</span>
                }
            </div>
            <p class="text-text-faint mt-1.5 text-micro leading-snug">
                Scenarios change PHYSICAL INPUTS on the simulator. On this feed
                the mill state arrives ready-made; the list is shown so the
                rehearsal set stays visible.
            </p>
        </div>

        <div class="border-line mt-2 border-t pt-2">
            <div class="label mb-1">FEED</div>
            <DerivedRow Label="Source" Value="@(Mill.Summary?.Communication.SourceName ?? "—")" Tone="dim" />
            <DerivedRow Label="Publish rate" Value="@(JsNumber.ToFixed(Mill.Summary?.Communication.UpdateRateHz ?? 0, 1))" Unit="Hz" Tone="dim" />
            <DerivedRow Label="Frame age" Value="@(JsNumber.ToFixed(Mill.Summary?.Communication.AgeMs ?? 0, 0))" Unit="ms" Tone="@(Stale ? "warning" : "dim")" />
            <DerivedRow Label="Frames received" Value="@((Mill.Summary?.Communication.FramesReceived ?? 0).ToString())" Tone="dim" />
        </div>
    </ChildContent>
</Panel>

@code {
    private int _seen = -1;

    protected override void OnInitialized() => Ticker.Tick += OnTick;

    private void OnTick() => InvokeAsync(StateHasChanged);

    protected override bool ShouldRender()
    {
        if (Mill.Version == _seen) return false;
        _seen = Mill.Version;
        return true;
    }

    private OperatingMode Mode => Mill.Summary?.Mode ?? OperatingMode.Simulation;
    private bool Stale => Mill.Summary?.Communication.Stale ?? true;
    private string StatusLabel => Mill.Summary?.StatusLabel ?? "—";

    private static readonly string[] Scenarios =
    [
        "Normal production", "High rolling force", "Thickness excursion", "AGC off (position mode)",
        "Hydraulic pressure low", "ETR gauge not ready", "Communication loss", "Emergency stop",
    ];

    private sealed record Trim(string Label, string Unit, string[] Steps);

    private static readonly Trim[] Trims =
    [
        new("Speed reference", "m/min", ["-25", "-5", "+5", "+25"]),
        new("Roll gap S0", "mm", ["-0.05", "-0.01", "+0.01", "+0.05"]),
        new("Entry tension", "kN", ["-10", "-2", "+2", "+10"]),
        new("Exit tension", "kN", ["-10", "-2", "+2", "+10"]),
    ];

    public void Dispose() => Ticker.Tick -= OnTick;
}
