@*
    Lucide icons, inlined.

    The React app used lucide-react. Rather than approximate the glyphs, the path data below is
    EXTRACTED FROM THE INSTALLED lucide-react PACKAGE, so an icon here is the same shape it was in
    the JSX. Inline rather than an external sprite: it is one fewer request, it inherits
    currentColor for free, and there is no sprite file to fall out of step with the markup.

    Every icon uses lucide's own 24x24 viewBox and 2px stroke conventions.
*@

<svg xmlns="http://www.w3.org/2000/svg" width="@Size" height="@Size" viewBox="0 0 24 24"
     fill="none" stroke="currentColor" stroke-width="@StrokeWidth" stroke-linecap="round"
     stroke-linejoin="round" class="@Class" aria-hidden="true" focusable="false">
    @((MarkupString)Body)
</svg>

@code {
    /// <summary>Icon name, matching the lucide component name used in the React source.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = default!;

    [Parameter] public int Size { get; set; } = 16;

    [Parameter] public double StrokeWidth { get; set; } = 2;

    [Parameter] public string Class { get; set; } = "";

    private string Body => Paths.TryGetValue(Name, out var d) ? d : string.Empty;

