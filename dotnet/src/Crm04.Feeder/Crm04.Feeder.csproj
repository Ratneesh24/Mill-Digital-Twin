<Project Sdk="Microsoft.NET.Sdk.Worker">

  <!--
    Crm04.Feeder - the write side, and the only thing that inserts into Oracle.

    Initially it replays a JSONL dataset exported from the existing TypeScript simulator
    (scripts/exportSimFrames.ts). The IFrameSource seam means a real OPC UA gateway source
    can replace the replay without touching the write path.

    Also hosts TrendRollupService and RetentionService - both writers, so both belong here
    rather than in the API.
  -->

  <PropertyGroup>
    <RootNamespace>Crm04.Feeder</RootNamespace>
    <UserSecretsId>crm04-feeder-4d05e489-3054-4659-800e-a20de80b97fb</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" />
    <PackageReference Include="Serilog.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crm04.Domain\Crm04.Domain.csproj" />
    <ProjectReference Include="..\Crm04.Persistence\Crm04.Persistence.csproj" />
  </ItemGroup>

</Project>
