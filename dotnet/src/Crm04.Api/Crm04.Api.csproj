<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Crm04.Api - the read side. Polls Oracle for new frames, runs the projection pipeline,
    and fans out over two SignalR hubs (/hubs/telemetry for the Blazor server process,
    /hubs/twin for browser JavaScript driving the three.js scene).

    Read-only against Oracle except for alarm acknowledgements. All writing lives in
    Crm04.Feeder.
  -->

  <PropertyGroup>
    <RootNamespace>Crm04.Api</RootNamespace>
    <UserSecretsId>crm04-api-8f3c1d20-7b64-4a19-9c02-2d6e5a1b7f44</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Protocols.MessagePack" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Swashbuckle.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Crm04.Domain\Crm04.Domain.csproj" />
    <ProjectReference Include="..\Crm04.Persistence\Crm04.Persistence.csproj" />
    <ProjectReference Include="..\Crm04.Contracts\Crm04.Contracts.csproj" />
  </ItemGroup>

</Project>
