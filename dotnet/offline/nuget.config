<?xml version="1.0" encoding="utf-8"?>
<!--
  OFFLINE BUILD CONFIG for the CRM04 digital twin.

  Copy this file into  dotnet\  (next to Crm04.sln) on the restricted server, and put the
  .nupkg files in     dotnet\offline-packages\ .

  <clear /> removes nuget.org, so no build on this machine will ever reach the internet
  again. If a package is genuinely missing you get NU1101 ("unable to find package X")
  naming it, instead of the NU1301 connection timeout - that is the point of clearing.

  The "value" below is relative to THIS FILE's folder, so it works on any drive letter.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="crm04-offline" value="offline-packages" />
  </packageSources>

  <!-- Belt and braces: even if a machine-wide config re-adds nuget.org, it stays off. -->
  <disabledPackageSources>
    <add key="nuget.org" value="true" />
  </disabledPackageSources>

  <config>
    <!-- Keep the extracted cache local and short. Long paths + the OPC UA package names
         exceed the Windows 260-character limit under deep folders. -->
    <add key="globalPackagesFolder" value="packages-cache" />
  </config>

</configuration>
